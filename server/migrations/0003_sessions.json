{
  "collections": {
    "portal_sessions": {
      "indexes": [
        {
          "name": "agent_updated",
          "keys": [["agent_id", 1], ["updated_at", -1], ["_id", -1]]
        },
        {
          "name": "agent_channel_chat",
          "keys": [["agent_id", 1], ["channel", 1], ["chat_id", 1]]
        },
        {
          "name": "agent_status",
          "keys": [["agent_id", 1], ["status", 1]]
        }
      ]
    }
  }
}
