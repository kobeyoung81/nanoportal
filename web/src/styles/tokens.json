  "legacy": {
    "background": "canvas",
    "foreground": "text",
    "card": "surface",
    "card-foreground": "text",
    "popover": "popoverSurface",
    "popover-foreground": "text",
    "primary": "accent",
    "primary-foreground": "onAccent",
    "secondary": "surface2",
    "secondary-foreground": "text",
    "muted": "surface2",
    "muted-foreground": "text2",
    "accent": "hoverSurface",
    "accent-foreground": "hoverText",
    "destructive": "danger",
    "border": "border",
    "input": "borderStrong",
    "ring": "accent",
