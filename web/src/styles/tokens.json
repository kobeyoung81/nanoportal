    "primary-weak": "accentWeak",
    "sidebar": "sidebar",
    "chart-bar": "chartBar",
    "caret-glow": "caretGlow",
    "user-message-bg": "userMessageBg",
    "user-message-fg": "userMessageFg",
    "user-message-border": "userMessageBorder"
  }
