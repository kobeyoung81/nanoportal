{
  "version": 1,
  "note": "主题的唯一源。结构只有几何/密度/排版，配色只有色值。改这里，跑 npm run sync:theme。",
  "structure": {
    "graphite": {
      "radius-sm": "6px",
      "radius-md": "8px",
      "radius-lg": "10px",
      "radius-xl": "14px",
      "control-h": "36px",
      "row-h": "44px",
      "gap": "16px",
      "pad": "16px",
      "sidebar-w": "256px",
      "header-h": "48px",
      "header-h-compact": "40px",
      "border-w": "1px",
      "rail-w": "2px",
      "font-size": "14px",
      "shadow-1": {
        "light": "0 1px 2px var(--c-shadow), 0 1px 3px var(--c-shadow-soft)",
        "dark": "inset 0 1px 0 var(--c-highlight)"
      },
      "shadow-2": {
        "light": "0 12px 32px var(--c-shadow-strong), 0 2px 6px var(--c-shadow)",
        "dark": "0 12px 32px var(--c-shadow-strong), inset 0 1px 0 var(--c-highlight-strong)"
      },
      "radius": "0.625rem",
      "pad-page": "24px",
      "pad-card": "24px",
      "pad-row": "12px",
      "pad-toolbar": "12px",
      "pad-control-x": "16px",
      "control-h-sm": "32px",
      "control-h-lg": "40px",
      "radius-pill": "999px"
    }
  },
  "palette": {
    "slate": {
      "light": {
        "canvas": "#eef2f7",
        "surface": "#ffffff",
        "popoverSurface": "#ffffff",
        "surface2": "#f5f8fc",
